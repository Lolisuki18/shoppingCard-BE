# Copy file này thành .env rồi điền giá trị thật
PORT=3000

# PostgreSQL (khớp với docker-compose.yml)
DATABASE_URL="postgresql://shoppingcard:shoppingcard@localhost:5433/shoppingcard?schema=public"

# Bí mật dùng để ký JWT -> mỗi cái nên là một chuỗi ngẫu nhiên dài
JWT_SECRET_ACCESS_TOKEN=
JWT_SECRET_REFRESH_TOKEN=
JWT_SECRET_EMAIL_VERIFY_TOKEN=
JWT_SECRET_FORGOT_PASSWORD_TOKEN=

# Thời hạn token (định dạng của jsonwebtoken: 15m, 7d, ...)
ACCESS_TOKEN_EXPIRE_IN=15m
REFRESH_TOKEN_EXPIRE_IN=100d
EMAIL_VERIFY_TOKEN_EXPIRE_IN=7d
FORGOT_PASSWORD_TOKEN_EXPIRE_IN=7d
