# Copy file này thành .env rồi điền giá trị thật
PORT=3000

# Origin của FE được phép gọi API, cách nhau bằng dấu phẩy ("*" = tất cả). Bỏ trống thì dùng CLIENT_URL
CORS_ORIGIN=http://localhost:8000
# Đứng sau reverse proxy thì đặt số lớp proxy (vd 1) để rate limit đếm đúng IP khách
TRUST_PROXY=
# production: log dạng JSON. LOG_LEVEL: debug | info | warn | error
NODE_ENV=development
LOG_LEVEL=info
# Log từng request (kèm X-Request-Id). Mặc định bật ở production, tắt ở dev
LOG_REQUESTS=
# true = lỗi 500 trả kèm chi tiết (CHỈ dùng khi dev). RATE_LIMIT_DISABLED=true tắt giới hạn tần suất (dùng khi test)
DEBUG_ERRORS=false
RATE_LIMIT_DISABLED=false

# PostgreSQL (khớp với docker-compose.yml)
DATABASE_URL="postgresql://shoppingcard:shoppingcard@localhost:5433/shoppingcard?schema=public"

# Bí mật dùng để ký JWT -> mỗi cái nên là một chuỗi ngẫu nhiên dài
JWT_SECRET_ACCESS_TOKEN=
JWT_SECRET_REFRESH_TOKEN=
JWT_SECRET_EMAIL_VERIFY_TOKEN=
JWT_SECRET_FORGOT_PASSWORD_TOKEN=

# Thời hạn token (định dạng của jsonwebtoken: 15m, 7d, ...)
ACCESS_TOKEN_EXPIRE_IN=15m
REFRESH_TOKEN_EXPIRE_IN=100d
EMAIL_VERIFY_TOKEN_EXPIRE_IN=7d
FORGOT_PASSWORD_TOKEN_EXPIRE_IN=7d

# Tài khoản admin tạo bởi npm run db:seed (đổi mật khẩu này! nếu có ký tự # thì phải đặt trong dấu ngoặc kép)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Địa chỉ công khai của BE (link xác thực email trỏ về đây) và của FE (link đặt lại mật khẩu trỏ về đây)
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:8000

# Gửi email (SMTP). Để trống SMTP_HOST thì mail chỉ được in ra log (dùng khi dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Shopping Card <no-reply@example.com>"
SHOP_NAME=Shopping Card

# Tự huỷ đơn Pending quá số giờ này mà chưa được xác nhận (trả hàng về kho). 0 = tắt
ORDER_AUTO_CANCEL_HOURS=48

# Phí vận chuyển (VND): phí chuẩn (0 = luôn miễn phí) và ngưỡng tiền hàng được miễn phí ship
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000

# Tài liệu API tại /docs: mặc định bật khi không phải production. Production muốn mở thì đặt true
ENABLE_DOCS=

# Xoá ảnh upload quá số giờ này mà chưa gắn vào sản phẩm / avatar / đơn hàng nào (và file lỗi trong thư mục tạm). 0 = tắt
ORPHAN_UPLOAD_MAX_AGE_HOURS=24
